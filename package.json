{
  "name": "patients-record-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "build:ios": "npx eas-cli build --platform ios --profile preview",
    "build:simulator": "npx eas-cli build --platform ios --profile simulator",
    "deploy:web": "node deploy.js",
    "update:push": "npx eas-cli update --branch production --environment production --clear-cache --message \"Deploying updates\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@huggingface/inference": "^4.13.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.99.1",
    "dotenv": "^17.4.0",
    "expo": "^57.0.16",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "^57.0.14",
    "expo-device": "~8.0.10",
    "expo-linking": "^57.0.7",
    "expo-location": "^55.1.4",
    "expo-router": "^57.0.16",
    "expo-sensors": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "^55.0.10",
    "expo-updates": "^57.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-google-fit": "^0.22.1",
    "react-native-health": "^1.13.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "surge": "^0.43.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "hermes-compiler": "^250829098.0.17",
    "typescript": "~5.9.2"
  },
